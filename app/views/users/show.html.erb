<%# Turbo Frame内の認証成功後はマイページ全体へ遷移する %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<%# ユーザーページ: 投稿者情報と、選択した一覧のイラストを表示 %>
<% content_for :title, "#{@profile_owner ? "マイページ" : "#{@user.name.presence || @user.user_id}さん"} | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: プロフィールと作品一覧 %>
  <main class="flex-1 px-5 py-10 sm:px-8 sm:py-14">
    <section class="mx-auto w-full max-w-6xl">
      <%# プロフィール見出し %>
      <p class="inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-200">MY ELEMENTS</p>
      <h1 class="mt-5 text-4xl font-black tracking-tight text-white sm:text-5xl"><%= @profile_owner ? "マイページ" : "#{@user.name.presence || @user.user_id}さんのページ" %></h1>
      <% if @profile_owner %>
        <p class="mt-3 text-lg leading-8 text-slate-300">ようこそ、<span class="font-bold text-cyan-200"><%= @user.name.presence || @user.user_id %></span>さん。あなたの作品を図鑑に追加しましょう。</p>
      <% end %>

      <%# プロフィールカード %>
      <section class="card mt-8 rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-900 p-6 shadow-2xl shadow-cyan-950/50 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-cyan-400 text-2xl font-black text-slate-950"><%= (@user.name.presence || @user.user_id).first.upcase %></div>
            <div>
              <%# ユーザー名と設定導線: マイページだけで現在のユーザー情報を編集できる %>
              <div class="flex items-center gap-2">
                <p class="text-2xl font-bold text-white"><%= @user.name.presence || @user.user_id %></p>
                <% if @profile_owner %>
                  <%= link_to edit_user_registration_path, data: { turbo: false }, aria: { label: "ユーザー情報を編集" }, class: "btn btn-ghost btn-square btn-sm rounded-lg text-slate-300 transition hover:bg-white/10 hover:text-cyan-200" do %>
                    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="3"></circle>
                      <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.12 2.12-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V20.3h-3v-.08A1.7 1.7 0 0 0 10.68 18.66a1.7 1.7 0 0 0-1.88.34l-.06.06-2.12-2.12.06-.06A1.7 1.7 0 0 0 7.02 15a1.7 1.7 0 0 0-1.56-1.03H5.38v-3h.08A1.7 1.7 0 0 0 7.02 9.94a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.12-2.12.06.06a1.7 1.7 0 0 0 1.88.34 1.7 1.7 0 0 0 1.03-1.56V4.64h3v.08a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06L19.8 8l-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.56 1.03h.08v3h-.08A1.7 1.7 0 0 0 19.4 15Z"></path>
                    </svg>
                    <span class="sr-only">ユーザー情報を編集</span>
                  <% end %>
                <% end %>
              </div>
              <p class="mt-1 text-sm text-slate-400">ユーザーID: <%= @user.user_id %></p>
            </div>
          </div>

          <%# マイページのプロフィール枠からのみ、自分の推し元素図鑑へ移動できる %>
          <% if @profile_owner %>
            <%= link_to "推し元素図鑑", encyclopedia_entries_path, data: { turbo: false }, class: "btn btn-outline btn-sm h-auto min-h-0 rounded-xl border border-cyan-300/50 px-4 py-2 text-cyan-200 shadow-none transition hover:bg-cyan-300/10" %>
          <% end %>
        </div>
      </section>

      <%# イラスト一覧: 投稿といいね済み作品を切り替える %>
      <section class="mt-10">
        <% profile_path = @profile_owner ? mypage_path : user_path(@user) %>
        <% likes_profile_path = @profile_owner ? mypage_path(tab: "likes") : user_path(@user, tab: "likes") %>
        <% profile_name = @user.name.presence || @user.user_id %>
        <% posts_title = @profile_owner ? "あなたの投稿" : "#{profile_name}さんの投稿" %>
        <% likes_title = @profile_owner ? "あなたのいいね一覧" : "#{profile_name}さんのいいね一覧" %>

        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold tracking-[0.2em] text-cyan-300">ILLUSTRATIONS</p>
            <h2 class="mt-1 text-2xl font-black text-white"><%= @active_tab == "likes" ? likes_title : posts_title %></h2>
          </div>
          <% if @profile_owner %>
            <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300" %>
          <% end %>
        </div>

        <%# 一覧切替: 選択中のタブを色で示す %>
        <nav aria-label="ユーザーのイラスト一覧切替" class="mt-5 inline-flex rounded-lg border border-white/15 bg-slate-900 p-0.5 text-sm font-bold">
          <%= link_to "投稿一覧", profile_path, data: { turbo: false }, aria: { current: @active_tab == "posts" ? "page" : nil }, class: "rounded-md px-4 py-2 transition #{@active_tab == "posts" ? "bg-cyan-400 text-slate-950" : "text-slate-300 hover:bg-white/10"}" %>
          <%= link_to "いいね一覧", likes_profile_path, data: { turbo: false }, aria: { current: @active_tab == "likes" ? "page" : nil }, class: "rounded-md px-4 py-2 transition #{@active_tab == "likes" ? "bg-cyan-400 text-slate-950" : "text-slate-300 hover:bg-white/10"}" %>
        </nav>

        <%# 選択中のイラスト一覧: 共通カードを再利用する %>
        <% if @illustrations.any? %>
          <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            <%= render partial: "illustrations/card", collection: @illustrations, as: :illustration %>
          </div>
        <% else %>
          <div class="alert mt-5 rounded-2xl border border-dashed border-slate-600 bg-slate-900/60 p-8 text-center text-sm text-slate-400">まだイラストはありません。</div>
        <% end %>
      </section>
    </section>
  </main>
</div>
