          <p class="mt-3"><%= link_to "https://forms.gle/uwgDobjZ3MY72uiz7", "https://forms.gle/uwgDobjZ3MY72uiz7", target: "_blank", rel: "noopener noreferrer", class: "break-all text-cyan-300 underline underline-offset-4 hover:text-cyan-100" %></p>
