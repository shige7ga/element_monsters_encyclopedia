<%# ページネーション: 現在のクエリを維持して前後ページへ移動する %>
<% if collection.total_pages > 1 %>
  <nav aria-label="ページネーション" class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <%# 前のページ: 先頭ページでは無効表示にする %>
    <% if collection.prev_page %>
      <%= link_to t("views.shared.pagination.previous"), url_for(request.query_parameters.merge(page: collection.prev_page)), data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 rounded-lg border border-cyan-300/50 bg-transparent px-4 py-2 text-cyan-200 shadow-none transition hover:bg-cyan-300/10" %>
    <% else %>
      <span aria-disabled="true" class="btn btn-sm h-auto min-h-0 cursor-not-allowed rounded-lg border border-white/10 bg-transparent px-4 py-2 text-slate-600 shadow-none"><%= t("views.shared.pagination.previous") %></span>
    <% end %>

    <%# 現在位置: 並び替えやタブの条件はリンク先に引き継ぐ %>
    <span aria-current="page" class="rounded-lg border border-cyan-300/40 bg-cyan-300/10 px-4 py-2 text-sm font-bold text-cyan-100"><%= collection.current_page %> / <%= collection.total_pages %></span>

    <%# 次のページ: 最終ページでは無効表示にする %>
    <% if collection.next_page %>
      <%= link_to t("views.shared.pagination.next"), url_for(request.query_parameters.merge(page: collection.next_page)), data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 rounded-lg border border-cyan-300/50 bg-transparent px-4 py-2 text-cyan-200 shadow-none transition hover:bg-cyan-300/10" %>
    <% else %>
      <span aria-disabled="true" class="btn btn-sm h-auto min-h-0 cursor-not-allowed rounded-lg border border-white/10 bg-transparent px-4 py-2 text-slate-600 shadow-none"><%= t("views.shared.pagination.next") %></span>
    <% end %>
  </nav>
<% end %>
