<%# 図鑑ページ見出し: ラベル、タイトル、説明文の位置を共通化する %>
<div class="mt-3 flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= render "shared/section_label", label: label %>
    <h1 class="mt-2 text-3xl font-black text-white sm:text-4xl"><%= title %></h1>
    <p class="mt-1 text-sm text-slate-300"><%= description %></p>
  </div>

  <% if local_assigns[:header_action] %>
    <%= header_action %>
  <% end %>
</div>
