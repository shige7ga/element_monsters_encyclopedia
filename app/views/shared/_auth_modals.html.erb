<%# 共通認証モーダル: daisyUIのmodal構造を利用し、すべてのページのヘッダー操作から開く %>
<dialog data-modal-target="dialog" data-modal-dialog="registration" data-modal-source="<%= new_user_registration_path %>" data-action="click->modal#closeOnBackdrop" class="modal backdrop:bg-slate-950/70">
  <%= turbo_frame_tag "registration_modal", class: "modal-box w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl" do %>
    <div class="p-6 text-slate-600"><%= t("views.shared.loading") %></div>
  <% end %>
</dialog>

<dialog data-modal-target="dialog" data-modal-dialog="login" data-modal-source="<%= new_user_session_path %>" data-action="click->modal#closeOnBackdrop" class="modal backdrop:bg-slate-950/70">
  <%= turbo_frame_tag "login_modal", class: "modal-box w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl" do %>
    <div class="p-6 text-slate-600"><%= t("views.shared.loading") %></div>
  <% end %>
</dialog>
