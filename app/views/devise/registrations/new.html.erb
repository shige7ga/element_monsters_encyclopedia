<%# ユーザー登録モーダル用Turbo Frame %>
<%= turbo_frame_tag "registration_modal", class: "modal-box w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl" do %>
  <div class="p-6 sm:p-8">
    <%# モーダルタイトル・閉じるボタン %>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold"><%= t("views.devise.registration.title") %></h2>
      <button type="button" data-action="modal#close" class="btn btn-ghost btn-square btn-sm rounded-lg p-2 text-slate-500 hover:bg-slate-100" aria-label="<%= t("views.devise.close") %>">
        ✕
      </button>
    </div>

    <%# ユーザー登録フォーム %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-4", novalidate: true }) do |f| %>
      <%# 名前入力欄（任意） %>
      <div>
        <%= f.label :name, t("views.devise.registration.name_label"), class: "mb-1 block text-sm font-semibold" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input input-bordered w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:name].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:name).join("、") %></p>
        <% end %>
      </div>

      <%# ユーザーID入力欄 %>
      <div>
        <%= f.label :user_id, class: "mb-1 block text-sm font-semibold" %>
        <%= f.text_field :user_id, autocomplete: "username", class: "input input-bordered w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:user_id].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:user_id).join("、") %></p>
        <% end %>
      </div>

      <%# メールアドレス入力欄 %>
      <div>
        <%= f.label :email, class: "mb-1 block text-sm font-semibold" %>
        <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:email].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:email).join("、") %></p>
        <% end %>
      </div>

      <%# パスワード入力欄と文字数の注意書き %>
      <div>
        <div class="mb-1 flex items-center gap-2">
          <%= f.label :password, class: "text-sm font-semibold" %>

          <% if @minimum_password_length %>
            <p class="text-sm text-slate-500">
              <%= t("views.devise.registration.password_hint") %>
            </p>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>

        <% if resource.errors[:password].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:password).join("、") %></p>
        <% end %>
      </div>

      <%# パスワード確認入力欄 %>
      <div>
        <%= f.label :password_confirmation, class: "mb-1 block text-sm font-semibold" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:password_confirmation].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:password_confirmation).join("、") %></p>
        <% end %>
      </div>

      <%# ユーザー登録ボタンとログインへの切替導線 %>
      <%= f.submit t("views.devise.registration.submit"), class: "btn h-auto min-h-0 w-full rounded-lg bg-cyan-500 px-4 py-3 font-bold text-slate-950 hover:bg-cyan-400" %>
      <p class="text-center text-sm text-slate-600">
        <%= t("views.devise.registration.login_prompt") %>
        <button type="button" data-action="modal#switch" data-modal-dialog-param="login" class="font-bold text-cyan-700 underline underline-offset-2 transition hover:text-cyan-900"><%= t("views.devise.registration.login_link") %></button>
      </p>
    <% end %>
  </div>
<% end %>
