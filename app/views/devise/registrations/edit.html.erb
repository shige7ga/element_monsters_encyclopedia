<%# ユーザー情報編集: Deviseの現在ユーザー更新を利用してプロフィール情報を変更する %>
<% content_for :title, "ユーザー情報を編集 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <main class="flex-1 px-5 py-8 sm:px-8 sm:py-12">
    <section class="mx-auto w-full max-w-2xl">
      <%# マイページへの戻り導線 %>
      <%= link_to "← マイページへ戻る", mypage_path, data: { turbo: false }, class: "text-sm font-bold text-cyan-300 transition hover:text-cyan-100" %>

      <%# ページ見出し %>
      <div class="mt-6">
        <p class="text-sm font-semibold tracking-[0.16em] text-cyan-200">ACCOUNT SETTINGS</p>
        <h1 class="mt-2 text-3xl font-black text-white sm:text-4xl">ユーザー情報を編集</h1>
        <p class="mt-2 text-sm leading-6 text-slate-300">表示名、ユーザーID、メールアドレスを変更できます。</p>
      </div>

      <%# ユーザー情報の編集フォーム %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "card mt-8 rounded-3xl border border-white/15 bg-slate-900 p-6 shadow-2xl shadow-cyan-950/40 sm:p-8" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# 基本情報 %>
        <div class="space-y-5">
          <div>
            <%= f.label :name, class: "mb-2 block text-sm font-bold text-slate-200" %>
            <%= f.text_field :name, autocomplete: "name", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
            <% if resource.errors[:name].any? %>
              <p class="mt-2 text-sm text-rose-300"><%= resource.errors.full_messages_for(:name).join("、") %></p>
            <% end %>
          </div>

          <div>
            <%= f.label :user_id, class: "mb-2 block text-sm font-bold text-slate-200" %>
            <%= f.text_field :user_id, autocomplete: "username", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
            <% if resource.errors[:user_id].any? %>
              <p class="mt-2 text-sm text-rose-300"><%= resource.errors.full_messages_for(:user_id).join("、") %></p>
            <% end %>
          </div>

          <div>
            <%= f.label :email, class: "mb-2 block text-sm font-bold text-slate-200" %>
            <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
            <% if resource.errors[:email].any? %>
              <p class="mt-2 text-sm text-rose-300"><%= resource.errors.full_messages_for(:email).join("、") %></p>
            <% end %>
          </div>
        </div>

        <%# パスワード変更: 未入力なら現在のパスワードを維持する %>
        <div class="mt-8 border-t border-white/10 pt-6">
          <h2 class="text-lg font-bold text-white">パスワード変更</h2>
          <p class="mt-2 text-sm text-slate-400">変更しない場合は、新しいパスワード欄を空欄にしてください。</p>

          <div class="mt-5 space-y-5">
            <div>
              <%= f.label :password, "新しいパスワード", class: "mb-2 block text-sm font-bold text-slate-200" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
              <% if resource.errors[:password].any? %>
                <p class="mt-2 text-sm text-rose-300"><%= resource.errors.full_messages_for(:password).join("、") %></p>
              <% end %>
              <% if @minimum_password_length %>
                <p class="mt-2 text-sm text-slate-400">6〜32文字で入力してください。</p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "mb-2 block text-sm font-bold text-slate-200" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
              <% if resource.errors[:password_confirmation].any? %>
                <p class="mt-2 text-sm text-rose-300"><%= resource.errors.full_messages_for(:password_confirmation).join("、") %></p>
              <% end %>
            </div>
          </div>
        </div>

        <%# 更新確認: Devise標準どおり現在のパスワードを求める %>
        <div class="mt-8 border-t border-white/10 pt-6">
          <%= f.label :current_password, class: "mb-2 block text-sm font-bold text-slate-200" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input input-bordered w-full rounded-xl border-white/15 bg-slate-950 text-white outline-none transition focus:border-cyan-300" %>
          <p class="mt-2 text-sm text-slate-400">変更を保存するために入力してください。</p>
        </div>

        <%# 保存操作 %>
        <div class="mt-8 flex flex-wrap justify-end gap-3">
          <%= link_to t("common.buttons.cancel"), mypage_path, data: { turbo: false }, class: "btn btn-ghost h-auto min-h-0 rounded-xl border-0 px-4 py-2 text-slate-200 shadow-none transition hover:bg-white/10" %>
          <%= f.submit t("common.buttons.save"), class: "btn h-auto min-h-0 border-0 bg-cyan-400 px-5 py-2 font-bold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
        </div>
      <% end %>

      <%# アカウント削除: 全画面共通の削除確認ダイアログを使用する %>
      <section class="card mt-6 rounded-3xl border border-rose-300/25 bg-slate-900 p-6 sm:p-8">
        <h2 class="text-lg font-bold text-white">アカウント削除</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">アカウントを削除すると、関連する投稿や履歴も削除されます。</p>
        <div class="mt-5">
          <%= delete_confirmation_button t("common.buttons.delete_account"), registration_path(resource_name), class_name: "btn btn-sm h-auto min-h-0 border-0 bg-rose-400 px-4 py-2 text-slate-950 shadow-none transition hover:bg-rose-300" %>
        </div>
      </section>
    </section>
  </main>
</div>
