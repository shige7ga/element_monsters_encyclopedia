<%# ログインモーダル用Turbo Frame %>
<%= turbo_frame_tag "login_modal" do %>
  <div class="p-6 sm:p-8">
    <%# モーダルタイトル・閉じるボタン %>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold">ログイン</h2>
      <button type="button" data-action="modal#close" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100" aria-label="閉じる">
        ✕
      </button>
    </div>

    <%# ログインフォーム %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4", novalidate: true }) do |f| %>
      <%# メールアドレスまたはユーザーID入力欄 %>
      <div>
        <%= f.label :login, "メールアドレスまたはユーザーID", class: "mb-1 block text-sm font-semibold" %>
        <%= f.text_field :login, autofocus: true, autocomplete: "username", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:login].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:login).join("、") %></p>
        <% end %>
      </div>

      <%# パスワード入力欄とログインエラー %>
      <div>
        <%= f.label :password, "パスワード", class: "mb-1 block text-sm font-semibold" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-slate-950 focus:ring-1 focus:ring-slate-950" %>
        <% if resource.errors[:password].any? %>
          <p class="mt-1 text-sm text-rose-600"><%= resource.errors.full_messages_for(:password).join("、") %></p>
        <% end %>
        <% if flash[:alert].present? %>
          <p class="mt-1 text-sm text-rose-600"><%= flash[:alert] %></p>
        <% end %>
      </div>

      <%# ログイン状態保持チェックボックス %>
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-slate-300 text-cyan-500" %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "text-sm" %>
        </div>
      <% end %>

      <%# ログインボタン %>
      <%= f.submit "ログイン", class: "w-full rounded-lg bg-cyan-500 px-4 py-3 font-bold text-slate-950 hover:bg-cyan-400" %>
    <% end %>
  </div>
<% end %>
