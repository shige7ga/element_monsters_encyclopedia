<p><%= t("views.devise.mailer.greeting", email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t("views.devise.mailer.email_changed.pending_body", email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t("views.devise.mailer.email_changed.body", email: @resource.email) %></p>
<% end %>
