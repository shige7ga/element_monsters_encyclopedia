<%# 元素クイズ: PC・タブレットは左右、スマホは縦に問題と選択肢を表示 %>
<% content_for :title, "元素クイズ | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <main class="flex flex-1 items-center px-4 py-3 sm:px-6 md:py-4">
    <section class="mx-auto w-full max-w-5xl">
      <%# 出題進捗: 高さを抑え、クイズ本体を画面内に収める %>
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <%= render "shared/section_label", label: "LEARNING" %>
          <h1 class="text-lg font-black text-white sm:text-xl">元素クイズ</h1>
        </div>
        <p class="badge rounded-full border border-cyan-300/40 bg-cyan-300/10 px-3 py-2 text-xs font-bold text-cyan-100 sm:text-sm"><%= @question_number %> / 10 問</p>
      </div>
      <progress class="progress mt-3 h-1.5 w-full bg-slate-800 text-cyan-300" value="<%= @question_number %>" max="10"></progress>

      <%# クイズ本体: md以上で左にイラスト・元素記号、右に問題と選択肢を並べる %>
      <section class="card mt-4 grid gap-5 rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-950 p-4 shadow-2xl shadow-cyan-950/40 sm:p-5 md:grid-cols-2 md:items-center md:gap-8">
        <%# 学習補助: 公開済みの紐付けイラストを正方形枠に全体表示 %>
        <div class="flex flex-col items-center text-center">
          <div class="flex aspect-square w-[clamp(9rem,44vw,17rem)] items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-slate-900 p-2 md:w-[clamp(11rem,25vw,20rem)]">
            <% if @illustration %>
              <%= image_tag @illustration.image, alt: "#{@element.name}のイラスト: #{@illustration.monster_name}", class: "h-full w-full object-contain" %>
            <% else %>
              <p class="text-sm font-bold text-slate-400">イラスト未投稿</p>
            <% end %>
          </div>
          <p data-learning-question-symbol="<%= @element.symbol %>" class="mt-3 text-5xl font-black leading-none text-cyan-200 sm:text-6xl md:text-7xl"><%= @element.symbol %></p>
        </div>

        <%# 問題と回答: モバイルではイラスト・元素記号の下に続けて表示 %>
        <div>
          <p class="text-xs font-bold tracking-[0.2em] text-cyan-300">QUESTION</p>
          <h2 class="mt-2 text-center text-xl font-black text-white sm:text-2xl md:text-left">「<%= @element.symbol %>」の元素名は？</h2>

          <% if @answered %>
            <%# 回答後は正誤と正解を表示 %>
            <div class="alert mt-5 <%= @correct ? 'alert-success' : 'alert-error' %> rounded-2xl border p-4 <%= @correct ? 'border-emerald-300/50 bg-emerald-500/15 text-emerald-100' : 'border-rose-300/50 bg-rose-500/15 text-rose-100' %>">
              <div>
                <p class="font-black"><%= @correct ? "正解！" : "不正解" %></p>
                <p class="mt-1 text-sm">正しい答え：<span class="font-bold"><%= @element.symbol %>（<%= @element.name %>）</span></p>
              </div>
            </div>
            <%= button_to "次の問題", learning_next_path, method: :post, form: { data: { turbo: false } }, class: "btn mt-5 h-auto min-h-0 w-full rounded-xl border-0 bg-cyan-400 px-5 py-3 font-bold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
          <% else %>
            <%# 4択: スマホから2×2を維持し、タブレット以上でも左右領域に収める %>
            <div class="mt-5 grid grid-cols-2 gap-3">
              <% @choices.each do |choice| %>
                <%= button_to choice.name, learning_answer_path, method: :post, params: { element_id: choice.id }, form: { data: { turbo: false }, class: "w-full" }, class: "btn h-auto min-h-0 w-full rounded-xl border border-slate-600 bg-slate-900 px-3 py-3 text-center text-sm font-bold text-white shadow-none transition hover:border-cyan-300 hover:bg-cyan-300/10 sm:px-4 sm:py-4 sm:text-base" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    </section>
  </main>
</div>
