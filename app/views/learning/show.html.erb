<%# 学習画面: 元素記号を見て4択で元素名を答える %>
<% content_for :title, "元素クイズ | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <main class="flex-1 px-5 py-6 sm:px-8 sm:py-8">
    <section class="mx-auto w-full max-w-3xl">
      <%# ページ見出しと出題進捗 %>
      <%= render "shared/section_label", label: "LEARNING" %>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-black text-white sm:text-4xl">元素クイズ</h1>
          <p class="mt-1 text-sm text-slate-300">元素記号から元素名を選んでみよう。</p>
        </div>
        <p class="badge rounded-full border border-cyan-300/40 bg-cyan-300/10 px-4 py-3 text-sm font-bold text-cyan-100"><%= @question_number %> / 10 問</p>
      </div>
      <progress class="progress mt-4 h-2 w-full bg-slate-800 text-cyan-300" value="<%= @question_number %>" max="10"></progress>

      <%# 問題カード: 元素記号と学習用イラストを表示 %>
      <section class="card mt-6 rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-950 p-5 shadow-2xl shadow-cyan-950/40 sm:p-8">
        <p class="text-center text-sm font-bold tracking-[0.2em] text-cyan-300">QUESTION</p>
        <div class="mt-4 text-center">
          <p data-learning-question-symbol="<%= @element.symbol %>" class="text-6xl font-black text-white sm:text-7xl"><%= @element.symbol %></p>
          <h2 class="mt-3 text-xl font-bold text-slate-100">「<%= @element.symbol %>」の元素名は？</h2>
        </div>

        <%# 学習補助: 公開済みイラストがある場合のみランダムに表示 %>
        <div class="mx-auto mt-6 flex aspect-square w-full max-w-sm items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-slate-900 p-3">
          <% if @illustration %>
            <%= image_tag @illustration.image, alt: "#{@element.name}のイラスト: #{@illustration.monster_name}", class: "h-full w-full object-contain" %>
          <% else %>
            <p class="text-sm font-bold text-slate-400">イラスト未投稿</p>
          <% end %>
        </div>
      </section>

      <%# 回答選択肢: 回答前は4択、回答後は正誤と正解を表示 %>
      <section class="mt-6">
        <% if @answered %>
          <div class="alert <%= @correct ? 'alert-success' : 'alert-error' %> rounded-2xl border p-4 <%= @correct ? 'border-emerald-300/50 bg-emerald-500/15 text-emerald-100' : 'border-rose-300/50 bg-rose-500/15 text-rose-100' %>">
            <div>
              <p class="font-black"><%= @correct ? "正解！" : "不正解" %></p>
              <p class="mt-1 text-sm">正しい答え：<span class="font-bold"><%= @element.symbol %>（<%= @element.name %>）</span></p>
            </div>
          </div>

          <%# 次の問題への導線 %>
          <%= button_to "次の問題", learning_next_path, method: :post, form: { data: { turbo: false } }, class: "btn mt-5 h-auto min-h-0 w-full rounded-xl border-0 bg-cyan-400 px-5 py-3 font-bold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
        <% else %>
          <div class="grid gap-3 sm:grid-cols-2">
            <% @choices.each do |choice| %>
              <%= button_to choice.name, learning_answer_path, method: :post, params: { element_id: choice.id }, form: { data: { turbo: false }, class: "w-full" }, class: "btn h-auto min-h-0 w-full rounded-xl border border-slate-600 bg-slate-900 px-4 py-4 text-left font-bold text-white shadow-none transition hover:border-cyan-300 hover:bg-cyan-300/10" %>
            <% end %>
          </div>
        <% end %>
      </section>
    </section>
  </main>
</div>
