<%# 学習ダッシュボード: 将来のクイズ・履歴機能の入口となる画面 %>
<% content_for :title, "学習 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <main class="flex flex-1 items-center px-5 py-8 sm:px-8">
    <section class="card mx-auto w-full max-w-xl rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-950 p-6 text-center shadow-2xl shadow-cyan-950/40 sm:p-8">
      <%# 学習画面の見出し %>
      <%= render "shared/section_label", label: "LEARNING" %>
      <h1 class="mt-3 text-3xl font-black text-white sm:text-4xl">学習しよう</h1>
      <p class="mt-2 text-sm leading-6 text-slate-300">元素記号と元素名を、クイズで楽しく覚えよう。</p>

      <%# 現時点の学習状況。将来は別クイズや履歴カードをここへ追加する。 %>
      <div class="mt-7 rounded-2xl border border-cyan-300/30 bg-cyan-300/10 p-5">
        <% if user_signed_in? %>
          <p class="text-sm text-cyan-100">これまでのクイズ実施回数</p>
          <p class="mt-1 text-4xl font-black text-white"><%= @game_session_count %><span class="ml-1 text-lg">回</span></p>
        <% else %>
          <p class="text-sm leading-6 text-slate-300">ログインすると、クイズの実施回数と結果を保存できます。</p>
        <% end %>
      </div>

      <%# 現在提供する学習メニュー %>
      <div class="mt-7">
        <h2 class="text-lg font-bold text-white">元素名クイズ</h2>
        <p class="mt-1 text-sm text-slate-400">元素記号を見て、4択から元素名を選びます。</p>
        <%= link_to "クイズを始める", learning_quiz_path, data: { turbo: false }, class: "btn mt-5 h-auto min-h-0 rounded-xl border-0 bg-cyan-400 px-6 py-3 font-bold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
      </div>
    </section>
  </main>
</div>
