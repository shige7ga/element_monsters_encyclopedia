<%# トップページ固有コンテンツと認証モーダル %>
<% content_for :title, "元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 中央のサービス紹介をモンスターたちが囲むヒーローエリア %>
  <main class="flex flex-1 items-center px-5 py-12 sm:px-8 sm:py-20">
    <section id="encyclopedia" class="mx-auto grid w-full max-w-7xl items-center gap-8 lg:grid-cols-[0.8fr_1.4fr_0.8fr] lg:gap-4">
      <%# 左側のモンスター: 水素くん %>
      <figure class="order-2 mx-auto w-full max-w-xs text-center lg:order-1 lg:max-w-none">
        <%= image_tag "hydrogen_kun.png", alt: "水素くん", class: "mx-auto h-52 w-full object-contain sm:h-64 lg:h-[30rem]" %>
        <figcaption class="-mt-3 text-sm font-bold text-cyan-200">H・水素くん</figcaption>
      </figure>

      <%# 中央: サービスタイトル・キャッチコピー・主要導線 %>
      <div class="order-1 mx-auto max-w-2xl text-center lg:order-2">
        <p class="mb-5 inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-200">
          学びと創作がつながる場所
        </p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl">
          元素モンスターズ<br>図鑑
        </h1>
        <p class="mt-6 text-lg font-bold leading-relaxed text-cyan-200 sm:text-xl">
          見つけよう、推し元素。<br>「覚える」から「好きになる」へ。
        </p>
        <p class="mx-auto mt-5 max-w-xl leading-8 text-slate-300">
          個性豊かなモンスターたちと出会いながら、元素の名前や記号を楽しく学べる図鑑です。あなたの作品も、誰かの学びのきっかけになります。
        </p>

        <%# 図鑑を見る・ユーザー登録・ログインの主要導線 %>
        <div id="start" class="mt-9 flex flex-col items-center gap-3">
          <%= link_to "図鑑を見る", "#encyclopedia", class: "rounded-xl bg-cyan-400 px-8 py-3.5 font-bold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:bg-cyan-300" %>
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="rounded-xl bg-cyan-400 px-6 py-3.5 text-center font-bold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:bg-cyan-300">
              ユーザー登録
            </button>
            <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="rounded-xl border border-slate-500 px-6 py-3.5 text-center font-bold text-white transition hover:border-cyan-300 hover:bg-white/10">
              ログイン
            </button>
          </div>
        </div>
      </div>

      <%# 右側のモンスター: ヘリウムウィッチとリチウムゴーレム %>
      <div class="order-3 mx-auto flex w-full max-w-md items-end justify-center gap-2 sm:gap-5 lg:order-3 lg:max-w-none lg:flex-col lg:items-center lg:gap-0">
        <figure class="w-1/2 text-center lg:w-full">
          <%= image_tag "helium_witch.png", alt: "ヘリウムウィッチ", class: "mx-auto h-32 w-full object-contain sm:h-44 lg:h-56" %>
          <figcaption class="text-sm font-bold text-cyan-200">He・ヘリウムウィッチ</figcaption>
        </figure>
        <figure class="w-1/2 text-center lg:-mt-6 lg:w-full">
          <%= image_tag "lithium_golem.png", alt: "リチウムゴーレム", class: "mx-auto h-32 w-full object-contain sm:h-44 lg:h-56" %>
          <figcaption class="text-sm font-bold text-cyan-200">Li・リチウムゴーレム</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <%# 認証モーダル: Turbo Frameでフォームを読み込み、閉じても入力DOMを保持 %>
  <dialog data-modal-target="dialog" data-modal-dialog="registration" data-modal-source="<%= new_user_registration_path %>" data-action="click->modal#closeOnBackdrop" class="m-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70">
    <%= turbo_frame_tag "registration_modal" do %>
      <div class="p-6 text-slate-600">読み込み中...</div>
    <% end %>
  </dialog>

  <dialog data-modal-target="dialog" data-modal-dialog="login" data-modal-source="<%= new_user_session_path %>" data-action="click->modal#closeOnBackdrop" class="m-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70">
    <%= turbo_frame_tag "login_modal" do %>
      <div class="p-6 text-slate-600">読み込み中...</div>
    <% end %>
  </dialog>

</div>
