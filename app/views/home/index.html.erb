<%# トップページ固有コンテンツと認証モーダル %>
<% content_for :title, "元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: サービス概要と認証への主要導線 %>
  <main class="flex flex-1 items-center px-5 py-16 sm:px-8 sm:py-24">
    <section class="mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="text-center lg:text-left">
        <%# サービスタイトル・キャッチコピー %>
        <p class="mb-5 inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-200">
          学びと創作がつながる場所
        </p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl">
          元素モンスターズ<br class="hidden sm:block">図鑑
        </h1>
        <p class="mt-6 text-lg font-bold leading-relaxed text-cyan-200 sm:text-xl">
          見つけよう、推し元素。<br>「覚える」から「好きになる」へ。
        </p>
        <p class="mx-auto mt-5 max-w-xl leading-8 text-slate-300 lg:mx-0">
          元素をモチーフにした個性豊かなモンスターと出会いながら、元素の名前や記号を楽しく学べる図鑑です。あなたの作品も、誰かの学びのきっかけになります。
        </p>

        <%# ユーザー登録・ログインボタン %>
        <div id="start" class="mt-9 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
          <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="rounded-xl bg-cyan-400 px-6 py-3.5 text-center font-bold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:bg-cyan-300">
            ユーザー登録
          </button>
          <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="rounded-xl border border-slate-500 px-6 py-3.5 text-center font-bold text-white transition hover:border-cyan-300 hover:bg-white/10">
            ログイン
          </button>
        </div>
      </div>

      <%# モンスター画像: 元素記号を楽しく覚えられることを伝えるメインビジュアル %>
      <section id="encyclopedia" aria-labelledby="monster-showcase-title" class="relative mx-auto w-full max-w-xl rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-900 p-5 shadow-2xl shadow-cyan-950/50 sm:p-7">
        <p class="text-sm font-semibold tracking-[0.2em] text-cyan-300">MEET THE MONSTERS</p>
        <h2 id="monster-showcase-title" class="mt-3 text-2xl font-black text-white sm:text-3xl">
          モンスターと一緒に、元素記号を覚えよう！
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-300">
          水素・ヘリウム・リチウム。個性豊かな仲間たちが、あなたの学びを楽しくします。
        </p>

        <%# 3体のモンスターを同じ高さのカードに並べ、すぐ目に入るように表示 %>
        <div class="mt-5 grid grid-cols-3 items-end gap-2 sm:gap-3">
          <figure class="rounded-2xl border border-cyan-300/20 bg-slate-950/50 p-2 text-center sm:p-3">
            <%= image_tag "hydrogen_kun.png", alt: "水素くん", class: "h-28 w-full object-contain sm:h-36" %>
            <figcaption class="mt-2 text-xs font-bold text-cyan-200">H・水素</figcaption>
          </figure>
          <figure class="rounded-2xl border border-cyan-300/20 bg-slate-950/50 p-2 text-center sm:p-3">
            <%= image_tag "helium_witch.png", alt: "ヘリウムウィッチ", class: "h-28 w-full object-contain sm:h-36" %>
            <figcaption class="mt-2 text-xs font-bold text-cyan-200">He・ヘリウム</figcaption>
          </figure>
          <figure class="rounded-2xl border border-cyan-300/20 bg-slate-950/50 p-2 text-center sm:p-3">
            <%= image_tag "lithium_golem.png", alt: "リチウムゴーレム", class: "h-28 w-full object-contain sm:h-36" %>
            <figcaption class="mt-2 text-xs font-bold text-cyan-200">Li・リチウム</figcaption>
          </figure>
        </div>
      </section>
    </section>
  </main>

  <%# 認証モーダル: Turbo Frameでフォームを読み込み、閉じても入力DOMを保持 %>
  <dialog data-modal-target="dialog" data-modal-dialog="registration" data-modal-source="<%= new_user_registration_path %>" data-action="click->modal#closeOnBackdrop" class="m-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70">
    <%= turbo_frame_tag "registration_modal" do %>
      <div class="p-6 text-slate-600">読み込み中...</div>
    <% end %>
  </dialog>

  <dialog data-modal-target="dialog" data-modal-dialog="login" data-modal-source="<%= new_user_session_path %>" data-action="click->modal#closeOnBackdrop" class="m-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70">
    <%= turbo_frame_tag "login_modal" do %>
      <div class="p-6 text-slate-600">読み込み中...</div>
    <% end %>
  </dialog>

</div>
