<%# トップページ固有コンテンツと認証モーダル %>
<% content_for :title, "元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 中央のサービス紹介をモンスターたちが囲むヒーローエリア %>
  <main class="flex flex-1 items-start px-5 pt-10 pb-12 sm:px-8 sm:pt-12 sm:pb-16">
    <section id="encyclopedia" class="mx-auto grid w-full max-w-7xl items-center gap-8 lg:grid-cols-[0.8fr_1.4fr_0.8fr] lg:gap-4">
      <%# 左側のモンスター: 水素くん %>
      <figure class="relative order-2 mx-auto w-full max-w-xs text-center lg:order-1 lg:max-w-none">
        <%= image_tag "hydrogen_kun.png", alt: "水素くん", class: "mx-auto h-52 w-full object-contain sm:h-64 lg:h-[30rem]" %>
        <%# 右下: キャラクター名の左に元素記号バッジを並べる %>
        <div class="absolute bottom-2 right-2 flex items-center gap-2">
          <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-cyan-200 bg-slate-950/85 text-lg font-black text-cyan-200 shadow-lg sm:h-12 sm:w-12 sm:text-xl">H</span>
          <span class="rounded-full bg-slate-950/85 px-3 py-1 text-sm font-bold text-cyan-200 shadow-lg">水素くん</span>
        </div>
      </figure>

      <%# 中央: サービスタイトル・キャッチコピー・主要導線 %>
      <div class="order-1 mx-auto max-w-2xl text-center lg:order-2">
        <%# 主コピー: 元のタグ風デザインを維持し、画面幅に応じて控えめに拡大する %>
        <p class="mb-3 inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-200 sm:px-4 sm:py-1.5 sm:text-sm">
          学びと創造がつながる空間
        </p>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl">
          元素モンスターズ<br>図鑑
        </h1>

        <%# キャッチコピー: 既存の強さと余白を保つ2行構成 %>
        <p class="mt-6 text-lg font-bold leading-relaxed text-cyan-200 sm:text-xl">
          「覚える」から「好きになる」へ。<br>
          見つかる、推し元素。<br>
          あなたの発想が、未来の科学者をつくる。
        </p>

        <%# サービス紹介文 %>
        <p class="mx-auto mt-5 max-w-xl leading-8 text-slate-300">
          創って、探して、学んで、楽しめる。個性豊かなモンスターたちと出会いながら、元素記号や元素名を楽しく学べるイラスト投稿型の図鑑アプリです。
        </p>

        <%# 図鑑を見る・モンスターを作る・認証の主要導線 %>
        <div id="start" class="mt-9 flex flex-col items-center gap-3">
          <div class="flex flex-wrap justify-center gap-3">
            <%= link_to "図鑑を見る", illustrations_path, data: { turbo: false }, class: "button-interaction rounded-xl bg-cyan-400 px-8 py-3.5 font-bold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:bg-cyan-300" %>
            <%= link_to "モンスターを作る", ai_generation_assist_path, data: { turbo: false }, class: "button-interaction rounded-xl border border-violet-300 bg-violet-300 px-8 py-3.5 font-bold text-slate-950 shadow-lg shadow-violet-500/20 transition hover:-translate-y-0.5 hover:bg-violet-200" %>
          </div>
          <div class="flex flex-row justify-center gap-3">
            <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="rounded-xl border border-slate-500 px-6 py-3.5 text-center font-bold text-white transition hover:border-cyan-300 hover:bg-white/10">
              ユーザー登録
            </button>
            <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="rounded-xl border border-slate-500 px-6 py-3.5 text-center font-bold text-white transition hover:border-cyan-300 hover:bg-white/10">
              ログイン
            </button>
          </div>
        </div>
      </div>

      <%# 右側のモンスター: ヘリウムウィッチとリチウムゴーレム %>
      <div class="order-3 mx-auto flex w-full max-w-md items-end justify-center gap-2 sm:gap-5 lg:order-3 lg:max-w-none lg:flex-col lg:items-center lg:gap-0">
        <figure class="relative w-1/2 text-center lg:w-full lg:-translate-x-8 lg:-translate-y-4">
          <%= image_tag "helium_witch.png", alt: "ヘリウムウィッチ", class: "mx-auto h-32 w-full object-contain sm:h-44 lg:h-56" %>
          <%# 右下: キャラクター名の左に元素記号バッジを並べる %>
          <div class="absolute bottom-1 right-1 flex items-center gap-1 sm:bottom-2 sm:right-2 sm:gap-2">
            <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-full border border-cyan-200 bg-slate-950/85 text-sm font-black text-cyan-200 shadow-lg sm:h-10 sm:w-10 sm:text-lg">He</span>
            <span class="rounded-full bg-slate-950/85 px-2 py-1 text-xs font-bold text-cyan-200 shadow-lg sm:px-3 sm:text-sm">ヘリウムウィッチ</span>
          </div>
        </figure>
        <figure class="relative w-1/2 text-center lg:-mt-6 lg:w-full lg:translate-x-8 lg:translate-y-4">
          <%= image_tag "lithium_golem.png", alt: "リチウムゴーレム", class: "mx-auto h-32 w-full object-contain sm:h-44 lg:h-56" %>
          <%# 右下: キャラクター名の左に元素記号バッジを並べる %>
          <div class="absolute bottom-1 right-1 flex items-center gap-1 sm:bottom-2 sm:right-2 sm:gap-2">
            <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-full border border-cyan-200 bg-slate-950/85 text-sm font-black text-cyan-200 shadow-lg sm:h-10 sm:w-10 sm:text-lg">Li</span>
            <span class="rounded-full bg-slate-950/85 px-2 py-1 text-xs font-bold text-cyan-200 shadow-lg sm:px-3 sm:text-sm">リチウムゴーレム</span>
          </div>
        </figure>
      </div>
    </section>
  </main>


</div>
