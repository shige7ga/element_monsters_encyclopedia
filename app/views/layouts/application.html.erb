<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "元素モンスターズ図鑑" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="元素モンスターズ図鑑">
    <meta name="mobile-web-app-capable" content="yes">
    <%# ブラウザタブ用: public配下のロゴ画像を直接参照する %>
    <%= favicon_link_tag "/favicon.png", type: "image/png" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# cssbundling-railsでビルド済みのアプリケーションCSSのみを読み込む %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body data-controller="modal navigation" class="min-h-screen bg-slate-950 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col bg-slate-950">
      <%# 共通ヘッダー: サービス名とログイン状態別ナビゲーション %>
      <%# ヘッダー操作は通常遷移に統一し、連続操作時のTurbo fetch競合を防ぐ %>
      <header data-turbo="false" class="border-b border-white/10 bg-slate-950/90 px-5 py-4 backdrop-blur sm:px-8">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
          <%# サービスロゴ・タイトル %>
          <%= link_to root_path, class: "flex items-center gap-2 text-lg font-bold tracking-tight text-white sm:text-xl" do %>
            <%= image_tag "logo.png", alt: "元素モンスターズ図鑑LOGO", class: "h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10" %>
            <span>元素モンスターズ図鑑</span>
          <% end %>

          <%# PC用ナビゲーション %>
          <nav aria-label="メインナビゲーション" class="hidden items-center gap-2 text-sm font-semibold sm:flex">
            <%# 図鑑導線: 認証状態にかかわらず共通で表示 %>
            <%= link_to "図鑑を見る", elements_path, data: { turbo: false }, class: "rounded-lg bg-cyan-400 px-3 py-2 text-slate-950 transition hover:bg-cyan-300" %>
            <% if user_signed_in? %>
              <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "rounded-lg border border-cyan-300/50 px-3 py-2 text-cyan-200 transition hover:bg-cyan-300/10" %>
              <%= link_to "マイページ", mypage_path, class: "rounded-lg border border-white px-3 py-2 text-white transition hover:border-cyan-300 hover:bg-white/10" %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "rounded-lg border border-white px-3 py-2 text-white transition hover:border-cyan-300 hover:bg-white/10" %>
            <% else %>
              <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="rounded-lg border border-white px-3 py-2 text-white transition hover:border-cyan-300 hover:bg-white/10">ユーザー登録</button>
              <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="rounded-lg border border-white px-3 py-2 text-white transition hover:border-cyan-300 hover:bg-white/10">ログイン</button>
            <% end %>
          </nav>

          <%# モバイル用ハンバーガーボタン %>
          <button type="button" data-navigation-target="button" data-action="navigation#toggle" aria-label="メニューを開く" aria-expanded="false" class="rounded-lg p-2 text-white transition hover:bg-white/10 sm:hidden">
            <span class="block h-0.5 w-6 bg-current"></span>
            <span class="mt-1.5 block h-0.5 w-6 bg-current"></span>
            <span class="mt-1.5 block h-0.5 w-6 bg-current"></span>
          </button>
        </div>
      </header>

      <%# モバイル用ナビゲーション: 枠線を付けない %>
      <nav data-turbo="false" data-navigation-target="menu" aria-label="モバイルメインナビゲーション" class="hidden border-b border-white/10 bg-slate-900 px-5 py-3 sm:hidden">
        <div class="mx-auto flex max-w-6xl flex-col gap-2 text-sm font-semibold">
          <%# 図鑑導線: モバイルでも認証状態にかかわらず共通で表示 %>
          <%= link_to "図鑑を見る", elements_path, data: { turbo: false }, class: "rounded-lg bg-cyan-400 px-3 py-2 text-slate-950 transition hover:bg-cyan-300" %>
          <% if user_signed_in? %>
            <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "rounded-lg px-3 py-2 text-cyan-200 transition hover:bg-white/10" %>
            <%= link_to "マイページ", mypage_path, class: "rounded-lg px-3 py-2 text-slate-200 transition hover:bg-white/10" %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-white transition hover:bg-white/10" %>
          <% else %>
            <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="rounded-lg px-3 py-2 text-left text-slate-200 transition hover:bg-white/10">ユーザー登録</button>
            <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="rounded-lg px-3 py-2 text-left text-slate-200 transition hover:bg-white/10">ログイン</button>
          <% end %>
        </div>
      </nav>

      <%# ページ固有コンテンツ %>
      <%= yield %>

      <%# 全ページ共通の認証モーダル %>
      <%= render "shared/auth_modals" unless user_signed_in? %>

      <%# 共通フッター: 規約への導線 %>
      <footer class="border-t border-white/10 px-5 py-6 sm:px-8">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-sm text-slate-400 sm:flex-row">
          <p>&copy; <%= Time.current.year %> 元素モンスターズ図鑑</p>
          <nav aria-label="フッターナビゲーション" class="flex gap-5">
            <a href="#" class="transition hover:text-cyan-300">利用規約</a>
            <a href="#" class="transition hover:text-cyan-300">プライバシーポリシー</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
