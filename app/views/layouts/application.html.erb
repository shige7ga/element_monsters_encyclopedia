<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "元素モンスターズ図鑑" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="元素モンスターズ図鑑">
    <meta name="mobile-web-app-capable" content="yes">
    <%# ブラウザタブ用: public配下のロゴ画像を直接参照する %>
    <%= favicon_link_tag "/favicon.png", type: "image/png" %>
    <%# スマホのホーム画面アイコン用 %>
    <%= tag.link rel: "apple-touch-icon", href: asset_path("apple-touch-icon.png"), sizes: "180x180" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# cssbundling-railsでビルド済みのアプリケーションCSSのみを読み込む %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body data-controller="modal navigation delete-confirmation" data-action="resize@window->navigation#closeOnDesktop" class="min-h-screen bg-slate-950 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col bg-slate-950">
      <%# 共通ヘッダー: サービス名とログイン状態別ナビゲーション %>
      <%# ヘッダー操作は通常遷移に統一し、連続操作時のTurbo fetch競合を防ぐ %>
      <header data-turbo="false" class="border-b border-white/10 bg-slate-950/90 px-5 py-4 backdrop-blur sm:px-8">
        <div class="navbar mx-auto min-h-0 max-w-6xl flex-nowrap justify-between gap-4 p-0">
          <%# サービスロゴ・タイトル %>
          <%= link_to root_path, class: "flex min-w-0 items-center gap-2 text-lg font-bold tracking-tight text-white sm:text-xl" do %>
            <%= image_tag "logo.png", alt: "元素モンスターズ図鑑LOGO", class: "h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10" %>
            <span class="truncate">元素モンスターズ図鑑</span>
          <% end %>

          <%# PC用ナビゲーション %>
          <nav aria-label="メインナビゲーション" class="hidden shrink-0 flex-nowrap items-center gap-2 text-sm font-semibold lg:flex">
            <%# 図鑑導線: 認証状態にかかわらず共通で表示 %>
            <%= link_to "図鑑を見る", elements_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
            <%= link_to "学習する", learning_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
            <% if user_signed_in? %>
              <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
              <%= link_to "推し元素図鑑", encyclopedia_entries_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
              <% if current_user.admin? %>
                <%= link_to "管理画面", admin_root_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 border-0 bg-amber-300 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-amber-200" %>
              <% end %>
              <%= link_to "マイページ", mypage_path, class: "btn btn-sm h-auto min-h-0 rounded-lg border border-white bg-transparent px-3 py-2 text-white shadow-none transition hover:border-cyan-300 hover:bg-white/10" %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { class: "shrink-0" }, class: "btn btn-sm h-auto min-h-0 rounded-lg border border-white bg-transparent px-3 py-2 text-white shadow-none transition hover:border-cyan-300 hover:bg-white/10" %>
            <% else %>
              <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="btn btn-sm h-auto min-h-0 rounded-lg border border-white bg-transparent px-3 py-2 text-white shadow-none transition hover:border-cyan-300 hover:bg-white/10">ユーザー登録</button>
              <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="btn btn-sm h-auto min-h-0 rounded-lg border border-white bg-transparent px-3 py-2 text-white shadow-none transition hover:border-cyan-300 hover:bg-white/10">ログイン</button>
            <% end %>
          </nav>

          <%# モバイル用ハンバーガーボタン %>
          <button type="button" data-navigation-target="button" data-action="navigation#toggle" aria-label="メニューを開く" aria-controls="mobile-navigation" aria-expanded="false" class="btn btn-ghost btn-square btn-sm flex flex-col justify-center gap-1.5 rounded-lg p-2 text-white transition hover:bg-white/10 lg:hidden">
            <span class="block h-0.5 w-6 bg-current"></span>
            <span class="block h-0.5 w-6 bg-current"></span>
            <span class="block h-0.5 w-6 bg-current"></span>
          </button>
        </div>
      </header>

      <%# モバイル用ナビゲーション: 枠線を付けない %>
      <nav id="mobile-navigation" data-turbo="false" data-navigation-target="menu" aria-label="モバイルメインナビゲーション" class="hidden border-b border-white/10 bg-slate-900 px-5 py-3 lg:hidden">
        <div class="mx-auto flex max-w-6xl flex-col gap-2 text-sm font-semibold">
          <%# 図鑑導線: モバイルでも認証状態にかかわらず共通で表示 %>
          <%= link_to "図鑑を見る", elements_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 w-full justify-start border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
          <%= link_to "学習する", learning_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 w-full justify-start border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
          <% if user_signed_in? %>
            <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 w-full justify-start border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
            <%= link_to "推し元素図鑑", encyclopedia_entries_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 w-full justify-start border-0 bg-cyan-400 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-cyan-300" %>
            <% if current_user.admin? %>
              <%= link_to "管理画面", admin_root_path, data: { turbo: false }, class: "btn btn-sm h-auto min-h-0 w-full justify-start border-0 bg-amber-300 px-3 py-2 text-sm font-semibold text-slate-950 shadow-none transition hover:bg-amber-200" %>
            <% end %>
            <%= link_to "マイページ", mypage_path, class: "btn btn-ghost h-auto min-h-0 justify-start rounded-lg border-0 bg-transparent px-3 py-2 text-slate-200 shadow-none transition hover:bg-white/10" %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { class: "w-full" }, class: "btn btn-ghost h-auto min-h-0 w-full justify-start rounded-lg border-0 bg-transparent px-3 py-2 text-left text-white shadow-none transition hover:bg-white/10" %>
          <% else %>
            <button type="button" data-action="modal#open" data-modal-dialog-param="registration" class="btn btn-ghost h-auto min-h-0 justify-start rounded-lg border-0 bg-transparent px-3 py-2 text-left text-slate-200 shadow-none transition hover:bg-white/10">ユーザー登録</button>
            <button type="button" data-action="modal#open" data-modal-dialog-param="login" class="btn btn-ghost h-auto min-h-0 justify-start rounded-lg border-0 bg-transparent px-3 py-2 text-left text-slate-200 shadow-none transition hover:bg-white/10">ログイン</button>
          <% end %>
        </div>
      </nav>

      <%# ページ固有コンテンツ %>
      <%= yield %>

      <%# 全ページ共通の認証モーダル %>
      <%= render "shared/auth_modals" unless user_signed_in? %>

      <%# 全ページ共通の削除確認モーダル %>
      <%= render "shared/delete_confirmation_modal" %>

      <%# 共通フッター: 規約への導線 %>
      <footer class="border-t border-white/10 px-5 py-6 sm:px-8">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-sm text-slate-400 sm:flex-row">
          <p>&copy; <%= Time.current.year %> 元素モンスターズ図鑑</p>
          <%# 規約・お問い合わせへの共通導線 %>
          <nav aria-label="フッターナビゲーション" class="flex flex-wrap justify-center gap-x-5 gap-y-2">
            <%= link_to "利用規約", terms_path, class: "transition hover:text-cyan-300" %>
            <%= link_to "プライバシーポリシー", privacy_policy_path, class: "transition hover:text-cyan-300" %>
            <%= link_to "お問い合わせ", "https://forms.gle/uwgDobjZ3MY72uiz7", target: "_blank", rel: "noopener noreferrer", class: "transition hover:text-cyan-300" %>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
