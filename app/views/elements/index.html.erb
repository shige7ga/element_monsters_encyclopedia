<%# 周期表: 周期番号と元素の位置から詳細へ進める一覧画面 %>
<% content_for :title, "周期表 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# ページ見出しと操作案内 %>
  <main class="flex-1 px-3 py-1 sm:px-5 sm:py-2">
    <section class="mx-auto w-full max-w-7xl">
      <%# 図鑑内の表示切替: ページ最上部中央で周期表を選択状態にする %>
      <nav aria-label="図鑑表示切替" class="mx-auto flex w-fit rounded-lg border border-white/15 bg-slate-900 p-0.5 text-xs font-bold">
        <span aria-current="page" class="rounded-md bg-cyan-400 px-3 py-1 text-slate-950">周期表</span>
        <%= link_to "イラスト集", elements_path(anchor: "illustrations"), data: { turbo: false }, class: "rounded-md px-3 py-1 text-slate-300 transition hover:bg-white/10" %>
      </nav>
      <%# ページ見出し: 英語ラベルを周期表タイトルの右側に配置 %>
      <div class="mt-1 flex items-center gap-3">
        <h1 class="text-3xl font-black text-white sm:text-4xl">周期表</h1>
        <p class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-200">PERIODIC TABLE</p>
      </div>
      <p class="mt-1 text-sm text-slate-300">気になる元素記号を選んで、詳細を調べてみよう。</p>

      <%# 周期表本体: 左端に周期番号を置き、小画面では横スクロール %>
      <div class="mt-2 overflow-x-auto pb-0">
        <div data-controller="periodic-table" class="min-w-[640px] rounded-2xl border border-white/15 bg-slate-900/80 p-1.5 shadow-2xl shadow-cyan-950/40 sm:p-3">
          <div class="mb-1 grid grid-cols-[1.5rem_repeat(18,minmax(0,1fr))] gap-0.5 text-center text-xs font-bold text-slate-500">
            <span aria-hidden="true"></span>
            <% (1..18).each do |group_number| %><span><%= group_number %></span><% end %>
          </div>

          <%# 主周期表: 6・7周期3族は下段系列への案内セル %>
          <div class="space-y-1">
            <% (1..7).each do |period| %>
              <div class="grid grid-cols-[1.5rem_repeat(18,minmax(0,1fr))] gap-0.5" aria-label="第<%= period %>周期">
                <span class="flex items-center justify-center text-xs font-bold text-slate-500"><%= period %></span>
                <% (1..18).each do |group_number| %>
                  <% if period == 6 && group_number == 3 %>
                    <div class="flex aspect-square items-center justify-center rounded-lg border border-rose-300 bg-rose-500/25 px-1 text-center text-[0.6rem] font-black text-rose-100">ランタノイド</div>
                  <% elsif period == 7 && group_number == 3 %>
                    <div class="flex aspect-square items-center justify-center rounded-lg border border-emerald-300 bg-emerald-500/25 px-1 text-center text-[0.6rem] font-black text-emerald-100">アクチノイド</div>
                  <% elsif (element = @elements_by_position[[period, group_number]]) %>
                    <%= render "element_cell", element: element %>
                  <% else %>
                    <div aria-hidden="true"></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# 下段系列: 左端の周期番号の次、すなわち第3族の直下から表示 %>
          <div class="mt-2 space-y-1 border-t border-white/10 pt-2">
            <% { "ランタノイド" => [@lanthanides, "border-rose-300 bg-rose-500/25 text-rose-100"], "アクチノイド" => [@actinides, "border-emerald-300 bg-emerald-500/25 text-emerald-100"] }.each do |label, (elements, color_class)| %>
              <div class="grid grid-cols-[1.5rem_repeat(18,minmax(0,1fr))] gap-0.5" aria-label="<%= label %>">
                <span aria-hidden="true"></span>
                <div aria-hidden="true"></div>
                <div aria-hidden="true"></div>
                <% elements.each do |element| %><%= render "element_cell", element: element, series_class: color_class %><% end %>
              </div>
            <% end %>
          </div>
          <%# 共通ポップアップ: 118個のセルに重複DOMを作らない %>
          <div data-periodic-table-target="popup" class="fixed z-30 hidden w-56 rounded-xl border border-cyan-200/30 bg-slate-950 p-4 text-left shadow-2xl">
            <button type="button" data-action="periodic-table#close" class="absolute right-3 top-2 text-slate-400" aria-label="閉じる">×</button>
            <p data-periodic-table-target="symbol" class="text-xs font-semibold text-cyan-300"></p>
            <p data-periodic-table-target="name" class="mt-1 text-sm font-bold text-white"></p>
            <div class="mt-3 grid gap-2 text-xs font-bold <%= user_signed_in? ? "grid-cols-2" : "grid-cols-1" %>"><a data-periodic-table-target="detailLink" data-turbo="false" class="rounded-lg bg-cyan-400 px-2 py-2 text-center text-slate-950">詳細</a><% if user_signed_in? %><button type="button" disabled class="cursor-not-allowed rounded-lg border border-slate-600 px-2 py-2 text-slate-500">投稿</button><% end %></div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
