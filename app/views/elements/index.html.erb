<%# 周期表: 周期番号と元素の位置から詳細へ進める一覧画面 %>
<% content_for :title, "周期表 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# ページ見出しと操作案内 %>
  <main class="flex-1 px-5 py-12 sm:px-8 sm:py-16">
    <section class="mx-auto w-full max-w-7xl">
      <p class="inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-200">PERIODIC TABLE</p>
      <h1 class="mt-5 text-4xl font-black text-white sm:text-5xl">元素の周期表</h1>
      <p class="mt-3 text-lg text-slate-300">気になる元素記号を選ぶと、名前と次のアクションを確認できます。</p>

      <%# 周期表本体: 左端に周期番号を置き、小画面では横スクロール %>
      <div class="mt-10 overflow-x-auto pb-5">
        <div data-controller="periodic-table" class="min-w-[970px] rounded-3xl border border-white/15 bg-slate-900/80 p-4 shadow-2xl shadow-cyan-950/40 sm:p-6">
          <div class="mb-3 grid grid-cols-[2rem_repeat(18,minmax(0,1fr))] gap-1.5 text-center text-xs font-bold text-slate-500">
            <span>周期<br>＼<br>族</span>
            <% (1..18).each do |group_number| %><span><%= group_number %></span><% end %>
          </div>

          <%# 主周期表: 6・7周期3族は下段系列への案内セル %>
          <div class="space-y-1.5">
            <% (1..7).each do |period| %>
              <div class="grid grid-cols-[2rem_repeat(18,minmax(0,1fr))] gap-1.5" aria-label="第<%= period %>周期">
                <span class="flex items-center justify-center text-xs font-bold text-slate-500"><%= period %></span>
                <% (1..18).each do |group_number| %>
                  <% if period == 6 && group_number == 3 %>
                    <div class="flex aspect-square items-center justify-center rounded-lg border border-rose-300 bg-rose-500/25 px-1 text-center text-[0.6rem] font-black text-rose-100">ランタノイド</div>
                  <% elsif period == 7 && group_number == 3 %>
                    <div class="flex aspect-square items-center justify-center rounded-lg border border-emerald-300 bg-emerald-500/25 px-1 text-center text-[0.6rem] font-black text-emerald-100">アクチノイド</div>
                  <% elsif (element = @elements_by_position[[period, group_number]]) %>
                    <%= render "element_cell", element: element %>
                  <% else %>
                    <div aria-hidden="true"></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# 下段系列: 左端の周期番号の次、すなわち第3族の直下から表示 %>
          <div class="mt-5 space-y-1.5 border-t border-white/10 pt-5">
            <% { "ランタノイド" => [@lanthanides, "border-rose-300 bg-rose-500/25 text-rose-100"], "アクチノイド" => [@actinides, "border-emerald-300 bg-emerald-500/25 text-emerald-100"] }.each do |label, (elements, color_class)| %>
              <div class="grid grid-cols-[2rem_repeat(18,minmax(0,1fr))] gap-1.5" aria-label="<%= label %>">
                <span aria-hidden="true"></span>
                <div aria-hidden="true"></div>
                <div aria-hidden="true"></div>
                <% elements.each do |element| %><%= render "element_cell", element: element %><% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
