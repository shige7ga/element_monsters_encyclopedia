<%# 周期表: 周期番号と元素の位置から詳細へ進める一覧画面 %>
<% content_for :title, "周期表 | 元素モンスターズ図鑑" %>
<% lanthanide_class = "border-rose-300 bg-rose-500/25 text-rose-100" %>
<% actinide_class = "border-emerald-300 bg-emerald-500/25 text-emerald-100" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# ページ見出しと操作案内 %>
  <main class="flex-1 px-3 py-1 sm:px-5 sm:py-2">
    <section class="mx-auto w-full max-w-7xl">
      <%# 図鑑表示切替: 両図鑑ページで同じ位置に表示する %>
      <%= render "shared/catalog_switcher", active: :elements %>

      <%# 見出し: 両図鑑ページで同じ余白・高さに揃える %>
      <%= render "shared/catalog_header", label: "PERIODIC TABLE", title: "周期表", description: "気になる元素記号を選んで、詳細を調べてみよう。" %>

      <%# 周期表本体: 左端に周期番号を置き、小画面では横スクロール %>
      <div class="mt-2 overflow-x-auto pb-0">
        <div data-controller="periodic-table" class="w-full min-w-[720px] rounded-2xl border border-white/15 bg-slate-900/80 p-1.5 shadow-2xl shadow-cyan-950/40 sm:p-2">
          <div class="mb-0.5 grid grid-cols-[1.25rem_repeat(18,minmax(0,1fr))] gap-px text-center text-xs font-bold text-slate-500">
            <span aria-hidden="true"></span>
            <% (1..18).each do |group_number| %><span><%= group_number %></span><% end %>
          </div>

          <%# 主周期表: 6・7周期3族は下段系列への案内セル %>
          <div class="space-y-0.5">
            <% (1..7).each do |period| %>
              <div class="grid grid-cols-[1.25rem_repeat(18,minmax(0,1fr))] gap-px" aria-label="第<%= period %>周期">
                <span class="flex items-center justify-center text-xs font-bold text-slate-500"><%= period %></span>
                <% (1..18).each do |group_number| %>
                  <% if period == 6 && group_number == 3 %>
                    <div class="flex h-[clamp(1.9rem,2.6vw,2.75rem)] min-w-0 items-center justify-center overflow-hidden rounded-lg border <%= lanthanide_class %> px-1 text-center text-[0.6rem] font-black"><span class="lg:hidden">ラ</span><span class="hidden lg:inline">ランタノイド</span></div>
                  <% elsif period == 7 && group_number == 3 %>
                    <div class="flex h-[clamp(1.9rem,2.6vw,2.75rem)] min-w-0 items-center justify-center overflow-hidden rounded-lg border <%= actinide_class %> px-1 text-center text-[0.6rem] font-black"><span class="lg:hidden">ア</span><span class="hidden lg:inline">アクチノイド</span></div>
                  <% elsif (element = @elements_by_position[[period, group_number]]) %>
                    <%= render "element_cell", element: element %>
                  <% else %>
                    <div aria-hidden="true"></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# 下段系列: 左端の周期番号の次、すなわち第3族の直下から表示 %>
          <div class="mt-0.5 space-y-px border-t border-white/10 pt-1.5">
            <% { "ランタノイド" => [@lanthanides, lanthanide_class], "アクチノイド" => [@actinides, actinide_class] }.each do |label, (elements, color_class)| %>
              <div class="grid grid-cols-[1.25rem_repeat(18,minmax(0,1fr))] gap-px" aria-label="<%= label %>">
                <span aria-hidden="true"></span>
                <div aria-hidden="true"></div>
                <div aria-hidden="true"></div>
                <% elements.each do |element| %><%= render "element_cell", element: element, series_class: color_class %><% end %>
              </div>
            <% end %>
          </div>

          <%# 共通ポップアップ: 選択した元素の情報と遷移先をStimulusで設定する %>
          <div data-periodic-table-target="popup" class="fixed z-30 hidden w-56 rounded-xl border border-cyan-200/30 bg-slate-950 p-4 text-left shadow-2xl">
            <button type="button" data-action="periodic-table#close" class="absolute right-3 top-2 text-slate-400" aria-label="閉じる">×</button>
            <p data-periodic-table-target="symbol" class="text-xs font-semibold text-cyan-300"></p>
            <p data-periodic-table-target="name" class="mt-1 text-sm font-bold text-white"></p>

            <%# 操作リンク: 投稿リンクは選択した元素の投稿先へ動的に切り替える %>
            <div class="mt-3 grid grid-cols-2 gap-2 text-xs font-bold">
              <a data-periodic-table-target="detailLink" data-turbo="false" class="button-interaction rounded-lg bg-cyan-400 px-2 py-2 text-center text-slate-950">詳細</a>

              <% if user_signed_in? %>
                <button type="button" data-action="periodic-table#post" class="cursor-pointer rounded-lg border border-cyan-300/50 px-2 py-2 text-center text-cyan-200 transition hover:bg-cyan-300/10">投稿</button>
              <% else %>
                <button type="button" data-action="modal#open periodic-table#close" data-modal-dialog-param="registration" class="cursor-pointer rounded-lg border border-cyan-300/50 px-2 py-2 text-center text-cyan-200 transition hover:bg-cyan-300/10">投稿</button>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# 色分けの凡例: 専用色を使う下段系列だけを、周期表の補足として控えめに示す %>
      <aside aria-label="周期表の色分け" class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold text-slate-300">
        <div class="flex items-center gap-2">
          <span aria-hidden="true" class="h-3.5 w-3.5 rounded-sm border <%= lanthanide_class %>"></span>
          <span>ランタノイド</span>
        </div>
        <div class="flex items-center gap-2">
          <span aria-hidden="true" class="h-3.5 w-3.5 rounded-sm border <%= actinide_class %>"></span>
          <span>アクチノイド</span>
        </div>
      </aside>
    </section>
  </main>
</div>
