<%# 元素詳細: 一つの元素情報カードと関連イラストを表示 %>
<% content_for :title, "#{@element.name} | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 元素情報と下段の作品一覧 %>
  <main class="flex-1 px-5 py-6 sm:px-8 sm:py-8">
    <section class="mx-auto w-full max-w-6xl">
      <%# 戻る導線 %>
      <%= button_to "← 周期表へ戻る", elements_path, method: :get, form: { data: { turbo: false } }, class: "border-0 bg-transparent p-0 text-sm font-bold text-cyan-300 transition hover:text-cyan-100" %>

      <%# 元素情報カード: 原子番号から説明までを一つのカードに集約 %>
      <section class="mt-5 rounded-3xl border border-white/15 bg-gradient-to-br from-slate-800 to-slate-950 p-5 shadow-2xl shadow-cyan-950/40 sm:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl border border-cyan-300/40 bg-cyan-300/10 text-3xl font-black text-cyan-200 sm:h-24 sm:w-24 sm:text-4xl"><%= @element.symbol %></div>
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] text-cyan-300">ATOMIC NUMBER <%= @element.atomic_number %></p>
            <h1 class="mt-1 text-3xl font-black text-white"><%= @element.name %></h1>
            <p class="text-sm text-slate-300"><%= @element.english_name %></p>
          </div>
        </div>

        <%# 周期・族・常温状態 %>
        <dl class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-4"><dt class="text-sm text-slate-400">周期</dt><dd class="mt-1 text-lg font-bold text-white"><%= @element.period %>周期</dd></div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4"><dt class="text-sm text-slate-400">族</dt><dd class="mt-1 text-lg font-bold text-white"><%= @element.group_number %>族</dd></div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-4"><dt class="text-sm text-slate-400">常温での状態</dt><dd class="mt-1 text-lg font-bold text-cyan-200"><%= @element.common_state %></dd></div>
        </dl>

        <%# 元素の説明 %>
        <div class="mt-6 border-t border-white/10 pt-6">
          <h2 class="text-lg font-bold text-white">説明</h2>
          <p class="mt-2 leading-7 text-slate-300"><%= @element.description %></p>
        </div>
      </section>

      <%# 関連イラスト: 見出しは他ページと同じ枠付きラベルで統一 %>
      <section class="mt-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <%= render "shared/section_label", label: "ILLUSTRATIONS" %>
          <% if user_signed_in? %>
            <%= link_to "この元素を投稿する", new_illustration_path(element_id: @element.id), data: { turbo: false }, class: "rounded-xl border border-cyan-300/50 px-4 py-2 text-sm font-bold text-cyan-200 transition hover:bg-cyan-300/10" %>
          <% end %>
        </div>

        <% if @illustrations.any? %>
          <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            <%= render partial: "illustrations/card", collection: @illustrations, as: :illustration %>
          </div>
        <% else %>
          <div class="mt-5 rounded-2xl border border-dashed border-slate-600 bg-slate-900/60 p-8 text-center text-sm text-slate-400">この元素のイラストはまだありません。</div>
        <% end %>
      </section>
    </section>
  </main>
</div>
