<%# イラスト投稿: 新しい元素モンスターの作品を登録 %>
<% content_for :title, "イラスト投稿 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 投稿フォーム %>
  <main class="flex-1 px-5 py-10 sm:px-8 sm:py-14">
    <section class="mx-auto w-full max-w-2xl">
      <%# ページ見出し %>
      <p class="text-sm font-semibold tracking-[0.2em] text-cyan-300">NEW ILLUSTRATION</p>
      <h1 class="mt-2 text-3xl font-black text-white">イラスト投稿</h1>
      <p class="mt-2 text-sm text-slate-300">あなたが創った元素モンスターを投稿して、みんなで図鑑を育てよう！</p>

      <%# かんたん作成アシスト導線: 投稿前に少ない入力でAI向けプロンプトを作成できるよう案内する %>
      <aside class="mt-6 rounded-2xl border border-violet-300/40 bg-violet-300/10 p-4 sm:flex sm:items-center sm:justify-between sm:gap-5">
        <div>
          <p class="text-sm leading-6 text-slate-200">元素やモンスターの特徴を選ぶだけで、AIに作成を依頼するためのプロンプトを作れます。気軽に使ってイラスト投稿を楽しもう！</p>
        </div>
        <%= link_to "かんたん元素モンスター作成アシスト", ai_generation_assist_path, data: { turbo: false }, class: "btn mt-4 h-auto min-h-0 w-full shrink-0 rounded-xl border-0 bg-violet-300 px-4 py-3 text-sm font-bold text-slate-950 shadow-none transition hover:bg-violet-200 sm:mt-0 sm:w-auto" %>
      </aside>

      <%# 投稿フォーム本体 %>
      <div class="card mt-8 rounded-3xl border border-white/15 bg-slate-900 p-6 shadow-2xl shadow-cyan-950/40 sm:p-8">
        <%= render "form", illustration: @illustration %>
      </div>
    </section>
  </main>
</div>
