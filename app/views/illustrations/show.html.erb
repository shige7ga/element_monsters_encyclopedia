<%# イラスト詳細: PCでは画像と情報を2カラム、モバイルでは縦一列で表示 %>
<% content_for :title, "#{@illustration.monster_name} | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 左側の作品画像と右側の一体型情報カード %>
  <main class="flex-1 px-5 py-8 sm:px-8 sm:py-12">
    <section class="mx-auto w-full max-w-6xl">
      <%# 戻る導線 %>
      <%= link_to "← イラスト集へ戻る", illustrations_path, data: { turbo: false }, class: "text-sm font-bold text-cyan-300 transition hover:text-cyan-100" %>

      <%# 画像と詳細情報: 大画面は左右配置、小画面は画像から順に縦表示 %>
      <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <%# 作品画像: 正方形の濃色背景に画像全体を収める %>
        <div class="flex aspect-square max-h-[32rem] items-center justify-center overflow-hidden rounded-3xl border border-white/15 bg-slate-950 p-3 shadow-2xl shadow-cyan-950/40">
          <%= image_tag @illustration.image, alt: @illustration.monster_name, class: "block max-h-full max-w-full object-contain", style: "width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; object-position: center;" %>
        </div>

        <%# 詳細情報: 必要な情報を一つの枠に集約 %>
        <section class="card min-w-0 rounded-3xl border border-white/15 bg-slate-900 p-6 shadow-2xl shadow-cyan-950/40 sm:p-8">
          <%# モンスター名とAI生成表示: AI生成作品だけに控えめなバッジを付ける %>
          <div class="flex items-start justify-between gap-4">
            <h1 class="break-words text-3xl font-black text-white"><%= @illustration.monster_name %></h1>
            <% if @illustration.ai_generated? %>
              <span class="badge badge-ghost shrink-0 border border-white/20 bg-white/5 px-2 py-2 text-xs font-medium text-slate-300">AI生成</span>
            <% end %>
          </div>

          <%# 対象元素と説明 %>
          <dl class="mt-6 space-y-5 text-sm">
            <div>
              <dt class="text-slate-400">対象元素</dt>
              <dd class="mt-1 break-words text-lg font-bold text-cyan-200"><%= link_to "#{@illustration.element.symbol} · #{@illustration.element.name}", @illustration.element, data: { turbo: false }, class: "hover:text-cyan-100" %></dd>
            </div>
            <div class="border-t border-white/10 pt-5">
              <dt class="text-slate-400">説明</dt>
              <dd class="mt-2 whitespace-pre-wrap leading-7 text-slate-300"><%= @illustration.description.presence || "説明はまだありません。" %></dd>
            </div>
            <div class="border-t border-white/10 pt-5">
              <dt class="text-slate-400">投稿者</dt>
              <dd class="mt-1 break-words font-bold text-white"><%= link_to @illustration.user.name.presence || @illustration.user.user_id, user_path(@illustration.user), data: { turbo: false }, class: "hover:text-cyan-200" %></dd>
            </div>
          </dl>

          <%# いいね操作: 作品情報とともに件数・作成・解除を表示する %>
          <div class="mt-6 border-t border-white/10 pt-5">
            <%= render "likes/button", illustration: @illustration %>
          </div>

          <%# 投稿者本人のみの管理操作 %>
          <% if current_user == @illustration.user %>
            <div class="mt-8 flex flex-wrap gap-4 border-t border-white/10 pt-5 text-sm font-bold">
              <%= link_to "編集", edit_illustration_path(@illustration), data: { turbo: false }, class: "text-cyan-200 hover:text-cyan-100" %>
              <%= button_to "削除", @illustration, method: :delete, form: { data: { turbo_confirm: "このイラストを削除しますか？", turbo: false } }, class: "border-0 bg-transparent p-0 text-rose-300 hover:text-rose-100" %>
            </div>
          <% end %>
        </section>
      </div>
    </section>
  </main>
</div>
