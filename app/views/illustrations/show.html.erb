<%# イラスト詳細: PCでは画像と情報を2カラム、モバイルでは縦一列で表示 %>
<% content_for :title, "#{@illustration.monster_name} | 元素モンスターズ図鑑" %>

<% content_for :og_title, @illustration.monster_name.presence || "元素モンスターイラスト" %>
<% if @illustration.image.attached? %>
  <%# 本番環境とローカル環境での場合分けのためにog_image_urlを使用 %>
  <% content_for :og_image, og_image_url(@illustration.image) %>
<% end %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 左側の作品画像と右側の一体型情報カード %>
  <main class="flex-1 px-5 py-8 sm:px-8 sm:py-12">
    <section class="mx-auto w-full max-w-6xl">
      <%# 戻る導線 %>
      <%= link_to "← イラスト集へ戻る", illustrations_path, data: { turbo: false }, class: "text-sm font-bold text-cyan-300 transition hover:text-cyan-100" %>

      <%# 画像と詳細情報: 大画面は左右配置、小画面は画像から順に縦表示 %>
      <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <%# 作品画像: 正方形の濃色背景に画像全体を収める %>
        <div class="mx-auto aspect-square w-full max-w-[32rem] overflow-hidden rounded-3xl border border-white/15 bg-slate-950 p-3 shadow-2xl shadow-cyan-950/40 md:mx-0 md:max-w-none">
          <%= image_tag @illustration.image, alt: @illustration.monster_name, class: "block h-full w-full object-contain object-center" %>
        </div>

        <%# 詳細情報: 必要な情報を一つの枠に集約 %>
        <section class="card min-w-0 rounded-3xl border border-white/15 bg-slate-900 p-6 shadow-2xl shadow-cyan-950/40 sm:p-8">
          <%# モンスター名とAI生成表示: いいねはタイトルのすぐ下に配置する %>
          <div class="flex items-start justify-between gap-4">
            <h1 class="min-w-0 flex-1 break-words text-3xl font-black text-white"><%= @illustration.monster_name %></h1>
            <% if @illustration.ai_generated? %>
              <span class="badge badge-ghost shrink-0 border border-white/20 bg-white/5 px-2 py-2 text-xs font-medium text-slate-300">AI生成</span>
            <% end %>
          </div>
          <div class="mt-3">
            <%= render "likes/button", illustration: @illustration, alignment: "justify-start" %>
          </div>

          <%# 対象元素と説明 %>
          <dl class="mt-6 space-y-5 text-sm">
            <div>
              <dt class="text-slate-400">対象元素</dt>
              <dd class="mt-1 break-words text-lg font-bold text-cyan-200"><%= link_to "#{@illustration.element.symbol} · #{@illustration.element.name}", @illustration.element, data: { turbo: false }, class: "hover:text-cyan-100" %></dd>
            </div>
            <div class="border-t border-white/10 pt-5">
              <dt class="text-slate-400">説明</dt>
              <dd class="mt-2 whitespace-pre-wrap leading-7 text-slate-300"><%= @illustration.description.presence || "説明はまだありません。" %></dd>
            </div>
            <div class="border-t border-white/10 pt-5">
              <dt class="text-slate-400">投稿者</dt>
              <dd class="mt-1 break-words font-bold text-white"><%= link_to @illustration.user.name.presence || @illustration.user.user_id, user_path(@illustration.user), data: { turbo: false }, class: "hover:text-cyan-200" %></dd>
            </div>
          </dl>

          <%# 推し登録: 共通ボタンと推し元素図鑑への導線を同じ行に配置する %>
          <% if user_signed_in? && @illustration.published? %>
            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-5">
              <%= render "encyclopedia_entries/button", illustration: @illustration, entry: @encyclopedia_entry %>
              <%= link_to "推し元素図鑑へ", encyclopedia_entries_path, data: { turbo: false }, class: "ml-auto text-sm font-bold text-cyan-200 transition hover:text-cyan-100" %>
            </div>
          <% end %>

          <%# X共有ボタン %>
          <div class="mb-5">
            <%
              share_text = "#{@illustration.monster_name} | #{@illustration.element.name}（#{@illustration.element.symbol}・原子番号#{@illustration.element.atomic_number}） | 元素モンスターズ図鑑"
            %>
            <%= link_to "𝕏 シェア",
              "https://twitter.com/intent/tweet?text=#{CGI.escape(share_text)}&url=#{CGI.escape(illustration_url(@illustration))}",
              target: "_blank",
              rel: "noopener noreferrer",
              class: "btn border bg-black border-white/10 text-white rounded-xl shadow-md hover:bg-neutral-800 hover:shadow-lg active:scale-95 transition" %>
          </div>

          <%# 投稿者本人のみの管理操作: 推し登録欄がある場合は区切り線を連続させる %>
          <% if current_user == @illustration.user %>
            <% management_margin_class = user_signed_in? && @illustration.published? ? "mt-0" : "mt-8" %>
            <div class="<%= management_margin_class %> flex flex-wrap gap-4 border-t border-white/10 pt-5 text-sm font-bold">
              <%= link_to "編集", edit_illustration_path(@illustration), data: { turbo: false }, class: "text-cyan-200 hover:text-cyan-100" %>
              <%= delete_confirmation_button "削除", illustration_path(@illustration), class_name: "border-0 bg-transparent p-0 text-rose-300 hover:text-rose-100" %>
            </div>
          <% end %>
        </section>
      </div>
    </section>
  </main>
</div>
