<%# 作品グリッド %>
<% if illustrations.any? %>
  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
    <%= render partial: "illustrations/card", collection: illustrations, as: :illustration %>
  </div>
  <%= render "shared/pagination", collection: illustrations %>
<% else %>
  <div class="alert mt-8 rounded-2xl border border-dashed border-slate-600 bg-slate-900/60 p-10 text-center">
    <p class="text-lg font-bold text-white">まだイラストはありません。</p>
  </div>
<% end %>
