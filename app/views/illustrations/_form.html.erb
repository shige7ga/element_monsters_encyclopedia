<%# 投稿フォーム: 元素・画像・モンスター名・説明・公開状態をまとめて入力 %>
<%= form_with model: illustration, class: "space-y-6", data: { turbo: false } do |form| %>
  <%# バリデーションエラー %>
  <% if illustration.errors.any? %>
    <div class="alert alert-error rounded-xl border border-rose-300/50 bg-rose-500/15 p-4 text-sm text-rose-100">
      <p class="font-bold">入力内容を確認してください。</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% illustration.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 対象元素の選択 %>
  <div>
    <%= form.label :element_id, "対象元素", class: "mb-1 block text-sm font-semibold text-slate-200" %>
    <%= form.collection_select :element_id, Element.order(:atomic_number), :id, ->(element) { "#{element.atomic_number} · #{element.symbol} — #{element.name}" }, { prompt: "元素を選択" }, class: "select select-bordered w-full rounded-lg border-slate-600 bg-slate-950 px-3 py-2 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" %>
  </div>

  <%# 画像とモンスター名 %>
  <div>
    <%= form.label :image, "イラスト画像", class: "mb-1 block text-sm font-semibold text-slate-200" %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", class: "file-input file-input-bordered block w-full rounded-lg border-dashed border-slate-500 bg-slate-950 px-3 py-2 text-sm text-slate-300 file:mr-4 file:rounded-md file:border-0 file:bg-cyan-400 file:px-3 file:py-2 file:font-bold file:text-slate-950" %>
    <p class="mt-1 text-xs text-slate-400">JPEG・PNG・WebP形式、5MB以下</p>
  </div>

  <div>
    <%= form.label :monster_name, "モンスター名", class: "mb-1 block text-sm font-semibold text-slate-200" %>
    <%= form.text_field :monster_name, class: "input input-bordered w-full rounded-lg border-slate-600 bg-slate-950 px-3 py-2 text-white outline-none transition focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" %>
  </div>

  <%# 説明: モンスターの特徴と元素の覚え方を一つの欄に統合 %>
  <div>
    <%= form.label :description, "説明（モンスターの特徴・元素の覚え方など）", class: "mb-1 block text-sm font-semibold text-slate-200" %>
    <%= form.text_area :description, rows: 5, placeholder: "モンスターの特徴や、元素記号・性質の覚え方などを入力してください", class: "textarea textarea-bordered w-full rounded-lg border-slate-600 bg-slate-950 px-3 py-2 text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300" %>
  </div>

  <%# 公開設定 %>
  <label class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-slate-200">
    <%= form.check_box :published, class: "checkbox checkbox-sm rounded border-slate-500 text-cyan-400 focus:ring-cyan-300" %>
    <span><span class="font-bold">公開する</span><br><span class="text-xs text-slate-400">非公開の作品は自分だけが閲覧できます。</span></span>
  </label>

  <%# 送信操作: Railsの自動ラベルを使わず画面種別ごとに明示 %>
  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit illustration.persisted? ? "更新する" : "投稿する", class: "btn h-auto min-h-0 rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300" %>
    <%= link_to "キャンセル", illustrations_path, data: { turbo: false }, class: "text-sm font-bold text-slate-300 transition hover:text-cyan-200" %>
  </div>
<% end %>
