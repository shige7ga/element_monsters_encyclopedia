<%# イラスト集: 公開作品と本人の非公開作品を画像中心のグリッドで表示 %>
<% content_for :title, "イラスト集 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 切替ナビと投稿作品一覧 %>
  <main class="flex-1 px-3 py-1 sm:px-5 sm:py-2">
    <section class="mx-auto w-full max-w-7xl">
      <%# 図鑑表示切替: 両図鑑ページで同じ位置に表示する %>
      <%= render "shared/catalog_switcher", active: :illustrations %>

      <%# 見出しと作成導線: AI作成は誰でも、投稿はログイン利用者がすぐ始められるよう並べる %>
      <% header_action = capture do %>
        <div class="flex flex-wrap gap-2">
          <%= link_to "AIでモンスターを作る", ai_generation_assist_path, data: { turbo: false }, class: "button-interaction rounded-xl border border-violet-300/70 px-4 py-3 text-sm font-bold text-violet-100 transition hover:bg-violet-300/10" %>
          <% if user_signed_in? %>
            <%= link_to "イラスト投稿", new_illustration_path, data: { turbo: false }, class: "button-interaction rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300" %>
          <% end %>
        </div>
      <% end %>
      <%= render "shared/catalog_header", label: "ILLUSTRATION GALLERY", title: (@gallery_title || "イラスト集"), description: (@gallery_description || "元素モンスターを見て、あなたの推し元素を探そう"), header_action: header_action %>

      <%# 一覧切替: おすすめ・新着・人気を切り替え、選択中の並び順を強調する %>
      <nav aria-label="イラスト一覧切替" class="mt-6 flex flex-wrap gap-2 text-sm font-bold">
        <%= link_to t("views.illustrations.sorts.recommended"), illustrations_path, data: { turbo: false }, aria: { current: @illustration_sort == "recommended" ? "page" : nil }, class: "button-interaction rounded-lg border px-3 py-2 transition #{@illustration_sort == "recommended" ? "border-cyan-300 text-cyan-200" : "border-white/15 text-slate-300 hover:border-cyan-300 hover:text-cyan-200"}" %>
        <%= link_to t("views.illustrations.sorts.newest"), illustrations_path(sort: "newest"), data: { turbo: false }, aria: { current: @illustration_sort == "newest" ? "page" : nil }, class: "button-interaction rounded-lg border px-3 py-2 transition #{@illustration_sort == "newest" ? "border-cyan-300 text-cyan-200" : "border-white/15 text-slate-300 hover:border-cyan-300 hover:text-cyan-200"}" %>
        <%= link_to t("views.illustrations.sorts.popular"), popular_illustrations_path, data: { turbo: false }, aria: { current: @illustration_sort == "popular" ? "page" : nil }, class: "button-interaction rounded-lg border px-3 py-2 transition #{@illustration_sort == "popular" ? "border-cyan-300 text-cyan-200" : "border-white/15 text-slate-300 hover:border-cyan-300 hover:text-cyan-200"}" %>
      </nav>

      <%# イラスト一覧 %>
      <%= render "illustrations_grid", illustrations: @illustrations %>
    </section>
  </main>
</div>
