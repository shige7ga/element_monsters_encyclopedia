<%# イラスト集: 公開作品と本人の非公開作品を画像中心のグリッドで表示 %>
<% content_for :title, "イラスト集 | 元素モンスターズ図鑑" %>

<div class="flex flex-1 flex-col bg-slate-950">
  <%# メイン: 切替ナビと投稿作品一覧 %>
  <main class="flex-1 px-3 py-1 sm:px-5 sm:py-2">
    <section class="mx-auto w-full max-w-7xl">
      <%# 図鑑表示切替: 両図鑑ページで同じ位置に表示する %>
      <%= render "shared/catalog_switcher", active: :illustrations %>

      <%# 見出しと投稿導線: 両図鑑ページで同じ余白・高さに揃える %>
      <%= render "shared/catalog_header", label: "ILLUSTRATION GALLERY", title: (@gallery_title || "イラスト集"), description: (@gallery_description || "元素モンスターを見て、あなたの推し元素を探そう"), header_action: (user_signed_in? ? link_to("イラスト投稿", new_illustration_path, data: { turbo: false }, class: "rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300") : nil) %>

      <%# 一覧切替: 新着順と人気順を切り替え、選択中の並び順を強調する %>
      <nav aria-label="イラスト一覧切替" class="mt-6 flex flex-wrap gap-2 text-sm font-bold">
        <%= link_to "新着", illustrations_path, data: { turbo: false }, aria: { current: action_name == "index" ? "page" : nil }, class: "rounded-lg border px-3 py-2 transition #{action_name == "index" ? "border-cyan-300 text-cyan-200" : "border-white/15 text-slate-300 hover:border-cyan-300 hover:text-cyan-200"}" %>
        <%= link_to "人気", popular_illustrations_path, data: { turbo: false }, aria: { current: action_name == "popular" ? "page" : nil }, class: "rounded-lg border px-3 py-2 transition #{action_name == "popular" ? "border-cyan-300 text-cyan-200" : "border-white/15 text-slate-300 hover:border-cyan-300 hover:text-cyan-200"}" %>
      </nav>

      <%# 作品グリッド %>
      <% if @illustrations.any? %>
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          <%= render partial: "card", collection: @illustrations, as: :illustration %>
        </div>
      <% else %>
        <div class="alert mt-8 rounded-2xl border border-dashed border-slate-600 bg-slate-900/60 p-10 text-center">
          <p class="text-lg font-bold text-white">まだイラストはありません。</p>
          <p class="mt-2 text-sm text-slate-400">最初の元素モンスターを投稿してみましょう。</p>
        </div>
      <% end %>
    </section>
  </main>
</div>
